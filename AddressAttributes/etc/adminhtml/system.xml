<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="addressattributes" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Allowed Pincodes</label>
            <tab>sales</tab>
            <resource>Codilar_AddressAttributes::config</resource>
            <group id="pincode" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable pincode restriction</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="csv_file" translate="label" type="file" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Allowed pincodes CSV</label>
                    <comment>Upload a CSV containing one pincode per row.</comment>
                    <backend_model>Codilar\AddressAttributes\Model\Config\Backend\PincodeCsv</backend_model>
                    <upload_dir config="system/filesystem/media" scope_info="1">addressattributes/pincodes</upload_dir>
                    <base_url type="media" scope_info="1">addressattributes/pincodes</base_url>
                </field>
                <field id="configured_pincodes" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Configured pincodes</label>
                    <comment>Read-only list loaded from the uploaded CSV file.</comment>
                    <frontend_model>Codilar\AddressAttributes\Block\Adminhtml\System\Config\Form\Field\PincodeCsv</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
