<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Codilar\HelloWorld\Block\Hello" name="codilar.helloworld.hello" template="Codilar_HelloWorld::hello.phtml" cacheable="false"/>
            <block class="Codilar\HelloWorld\Block\First" name="first.block" template="Codilar_HelloWorld::first.phtml"/>
            <block class="Codilar\HelloWorld\Block\Second" name="second.block" before="first.block" template="Codilar_HelloWorld::second.phtml"/>
        </referenceContainer>
    </body>
</page>
