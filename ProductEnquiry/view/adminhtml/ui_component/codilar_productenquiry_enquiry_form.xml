<?xml version="1.0" encoding="UTF-8"?>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                codilar_productenquiry_enquiry_form.codilar_productenquiry_enquiry_form_data_source
            </item>
        </item>
        <item name="label" xsi:type="string" translate="true">
            Product Enquiry
        </item>
        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
    </argument>

    <settings>
        <namespace>codilar_productenquiry_enquiry_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>
                codilar_productenquiry_enquiry_form.codilar_productenquiry_enquiry_form_data_source
            </dep>
        </deps>
        <buttons>
            <button name="back" class="Codilar\ProductEnquiry\Block\Adminhtml\Enquiry\Edit\Button\Back"/>
            <button name="save" class="Codilar\ProductEnquiry\Block\Adminhtml\Enquiry\Edit\SaveButton"/>
        </buttons>
    </settings>

    <dataSource name="codilar_productenquiry_enquiry_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>
        <settings>
            <submitUrl path="codilar_productenquiry/enquiry/save"/>
        </settings>
        <dataProvider name="codilar_productenquiry_enquiry_form_data_source" class="Codilar\ProductEnquiry\Ui\DataProvider\Enquiry\Form\DataProvider">
            <settings>
                <requestFieldName>enquiry_id</requestFieldName>
                <primaryFieldName>enquiry_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Product Enquiry Information</label>
        </settings>
        <field name="enquiry_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>enquiry_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="email" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Email</label>
                <dataScope>email</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-email" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sku" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">SKU</label>
                <dataScope>sku</dataScope>
            </settings>
        </field>
        <field name="quantity" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Quantity</label>
                <dataScope>quantity</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
