<?xml version="1.0" encoding="UTF-8"?>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                codilar_productenquiry_enquiry_form.codilar_productenquiry_enquiry_form_data_source
            </item>
        </item>
        <item name="label" xsi:type="string" translate="true">
            Product Enquiry
        </item>
        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
    </argument>

    <settings>
        <namespace>codilar_productenquiry_enquiry_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>
                codilar_productenquiry_enquiry_form.codilar_productenquiry_enquiry_form_data_source
            </dep>
        </deps>
        <buttons>
            <button name="back" class="Codilar\ProductEnquiry\Block\Adminhtml\Enquiry\Edit\Button\Back"/>
            <button name="save" class="Codilar\ProductEnquiry\Block\Adminhtml\Enquiry\Edit\SaveButton"/>
        </buttons>
    </settings>

    <dataSource name="codilar_productenquiry_enquiry_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>
        <settings>
            <submitUrl path="codilar_productenquiry/enquiry/save"/>
        </settings>
        <dataProvider name="codilar_productenquiry_enquiry_form_data_source" class="Codilar\ProductEnquiry\Ui\DataProvider\Enquiry\Form\DataProvider">
            <settings>
                <requestFieldName>enquiry_id</requestFieldName>
                <primaryFieldName>enquiry_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Product Enquiry Information</label>
        </settings>
        <field name="enquiry_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>enquiry_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="email" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Email</label>
                <dataScope>email</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-email" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sku" formElement="input" component="Codilar_ProductEnquiry/js/form/element/product-sku">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="imports" xsi:type="array">
                        <item name="productSelection" xsi:type="string">
                            codilar_product_selector_listing.codilar_product_selector_listing.product_columns.ids:selected
                        </item>
                        <item name="productItems" xsi:type="string">
                            codilar_product_selector_listing.codilar_product_selector_listing_data_source:data.items
                        </item>
                    </item>
                </item>
            </argument>
            <settings>
                <disabled>true</disabled>
                <dataType>text</dataType>
                <label translate="true">SKU</label>
                <dataScope>sku</dataScope>
            </settings>
        </field>
        <button name="add_product" component="Magento_Ui/js/form/components/button">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">
                        Add Product
                    </item>
                    <item name="label" xsi:type="string" translate="true">
                        Add Product
                    </item>
                    <item name="buttonClasses" xsi:type="string">
                        action-secondary
                    </item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">
                                ${$.parentName}.product_selector_modal
                            </item>
                            <item name="actionName" xsi:type="string">
                                openModal
                            </item>
                        </item>
                    </item>
                </item>
            </argument>
        </button>
        <field name="quantity" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Quantity</label>
                <dataScope>quantity</dataScope>
            </settings>
        </field>
        <modal name="product_selector_modal">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="options" xsi:type="array">
                        <item name="title" xsi:type="string" translate="true">
                            Add Product
                        </item>
                        <item name="type" xsi:type="string">
                            popup
                        </item>
                    </item>
                </item>
            </argument>
            <fieldset name="product_selector">
                <settings>
                    <label translate="true">Select Product</label>
                </settings>
                <insertListing name="product_selector_listing">
                    <settings>
                        <autoRender>true</autoRender>
                        <ns>codilar_product_selector_listing</ns>
                        <selectionsProvider>
                            codilar_product_selector_listing.product_columns.ids
                        </selectionsProvider>
                        <dataScope>product_selector</dataScope>
                    </settings>
                </insertListing>
            </fieldset>
        </modal>
    </fieldset>
</form>
