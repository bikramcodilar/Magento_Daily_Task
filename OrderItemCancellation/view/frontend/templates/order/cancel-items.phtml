                <div class="table-wrapper">
                    <table class="data table table-order-items">
                        <thead>
                        <tr>
                            <th><?= $escaper->escapeHtml(__('Product')) ?></th>
                            <th><?= $escaper->escapeHtml(__('Ordered')) ?></th>
