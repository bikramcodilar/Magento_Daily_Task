<?php
/** @var \Codilar\OrderItemCancellation\Block\CancelItems $block */
$order = $block->getOrder();
?>

<?php if ($block->canShowCancellationForm()): ?>
    <div class="block block-order-cancellation">
        <div class="block-title">
            <strong><?= $block->escapeHtml(__('Cancel Items')) ?></strong>
        </div>

        <div class="block-content">
            <p>
                <?= $block->escapeHtml(
                    __('Only unshipped and uninvoiced quantities can be cancelled.')
                ) ?>
            </p>

            <form action="<?= $block->escapeUrl($block->getSubmitUrl()) ?>"
                  method="post"
                  data-mage-init='{"validation":{}}'>

                <?= $block->getBlockHtml('formkey') ?>

                <input type="hidden"
                       name="order_id"
                       value="<?= (int) $order->getId() ?>">

                <input type="hidden"
                       name="request_token"
                       value="<?= $block->escapeHtmlAttr($block->getRequestToken()) ?>">

                <div class="table-wrapper">
                    <table class="data table table-order-items">
                        <thead>
                        <tr>
                            <th><?= $block->escapeHtml(__('Product')) ?></th>
                            <th><?= $block->escapeHtml(__('Ordered')) ?></th>
                            <th><?= $block->escapeHtml(__('Already Cancelled')) ?></th>
                            <th><?= $block->escapeHtml(__('Available to Cancel')) ?></th>
                            <th><?= $block->escapeHtml(__('Cancel Quantity')) ?></th>
                        </tr>
                        </thead>

                        <tbody>
                        <?php foreach ($block->getCancelableItems() as $item): ?>
                            <tr>
                                <td>
                                    <?= $block->escapeHtml($item->getName()) ?>
                                    <br>
                                    <small>
                                        <?= $block->escapeHtml(__('SKU: %1', $item->getSku())) ?>
                                    </small>
                                </td>

                                <td><?= $block->escapeHtml($item->getQtyOrdered() * 1) ?></td>
                                <td><?= $block->escapeHtml($item->getQtyCanceled() * 1) ?></td>
                                <td><?= $block->escapeHtml($item->getQtyToCancel() * 1) ?></td>

                                <td>
                                    <input type="number"
                                           class="input-text"
                                           name="items[<?= (int) $item->getId() ?>]"
                                           value="0"
                                           min="0"
                                           max="<?= $block->escapeHtmlAttr($item->getQtyToCancel()) ?>"
                                           step="0.0001"
                                           data-validate='{"validate-number":true}'>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>

                <div class="actions-toolbar">
                    <div class="primary">
                        <button type="submit" class="action primary">
                            <span><?= $block->escapeHtml(__('Cancel Selected Quantities')) ?></span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
<?php endif; ?>
